# Sin DATABASE_URL, SQLite usa prisma/dev.db.
# DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
# Genera un valor aleatorio: openssl rand -base64 48
SESSION_SECRET=
# Origen canónico detrás de un proxy (ejemplo: https://cms.ejemplo.com).
APP_ORIGIN=
# Define credenciales propias al inicializar el sitio.
SEED_ADMIN_PASSWORD=
SEED_EDITOR_PASSWORD=
# Opcional. Si se indica el bucket, todos los campos excepto STORAGE_ENDPOINT son necesarios.
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
